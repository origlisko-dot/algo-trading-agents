# =====================================================================
# algo-trading-agents — environment configuration
# Copy this file to ".env" and fill in the keys you have. Every key is
# OPTIONAL: connectors that lack credentials report MISSING_CREDENTIALS
# in `python scripts/check_connections.py` instead of crashing.
# =====================================================================

# ---- Global -----------------------------------------------------------
# Hard guardrail. Keep "true" until a strategy is proven on paper.
TRADING_PAPER=true
# Paper broker: simulated (default, no account) | ibkr | alpaca | auto
PAPER_BROKER=simulated
PAPER_STARTING_CASH=100000
PAPER_STATE_PATH=./runs/paper_account.json
# Comma-separated US tickers, or * / ALL / ALL US STOCK for any US equity (format-validated).
TRADING_UNIVERSE=*
# Max symbols per daily scan when TRADING_UNIVERSE is unrestricted (Finnhub/Polygon/Alpaca or seed).
TRADING_UNIVERSE_MAX=50
UNIVERSE_CACHE_PATH=./runs/universe_us.json
UNIVERSE_CACHE_HOURS=24

# ---- AGENTIC-OS ----
RUNS_DIR=./runs
DEFAULT_STRATEGY=auto
EVAL_GATE_ENABLED=true
MONITOR_AFTER_PAPER=true
AUTO_PROMOTE_STRATEGY=true
PROMOTION_COMPARE_ALL=true
# Monitor symbol cap (prefers runs/daily_watchlist.json when present).
MONITOR_MAX_SYMBOLS=10
# Prefer shadow-book total return over backtest Sharpe once each strategy has N snapshots.
SHADOW_MIN_SNAPSHOTS=3
AGENTIC_SCHEDULE_ENABLED=false
AGENTIC_SCHEDULE_HOUR=21
AGENTIC_SCHEDULE_MINUTE=30
AGENTIC_SCHEDULE_TZ=America/New_York
AGENTIC_SCHEDULE_WEEKDAYS=mon-fri
AGENTIC_SCHEDULE_POLL_SECONDS=60
LOG_LEVEL=INFO

# ---- Broker: Alpaca (recommended for US equities) ---------------------
# Get keys at https://alpaca.markets (use PAPER keys first).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper: https://paper-api.alpaca.markets | Live: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- Broker: Interactive Brokers (via ib-insync / TWS or Gateway) -----
IBKR_HOST=127.0.0.1
IBKR_PORT=7497            # 7497 = paper TWS, 7496 = live TWS, 4002/4001 = gateway
IBKR_CLIENT_ID=1

# ---- Market data ------------------------------------------------------
POLYGON_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
# yfinance needs no key (default fallback data source).

# ---- News -------------------------------------------------------------
NEWSAPI_KEY=
# SEC EDGAR needs no key but requires a descriptive User-Agent.
EDGAR_USER_AGENT=algo-trading-agents you@example.com

# ---- Hugging Face -----------------------------------------------------
# Only needed for gated/private models or the Inference API; public
# models (ProsusAI/finbert) work without a token.
HF_TOKEN=
FINBERT_MODEL=ProsusAI/finbert
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Memory (vector store) -------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db

# ---- LLM / LangSmith (optional — agents layer) -----------------------
# LangSmith: https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=algo-trading-agents
LANGCHAIN_TRACING_V2=true
# OpenRouter (recommended — OpenAI-compatible): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Or direct OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional override (auto-set to openrouter.ai when OPENROUTER_API_KEY is set)
LLM_BASE_URL=
# OpenRouter models use provider prefix, e.g. openai/gpt-4o-mini, google/gemma-2-9b-it:free
LLM_MODEL=openai/gpt-4o-mini
